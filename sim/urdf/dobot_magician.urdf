<?xml version="1.0"?>
<robot name="dobot_magician">

  <link name="base">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder length="0.04" radius="0.06"/></geometry>
      <material name="base_gray"><color rgba="0.35 0.35 0.4 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder length="0.04" radius="0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="1.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder length="0.10" radius="0.038"/></geometry>
      <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder length="0.10" radius="0.038"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0.11 0 0" rpy="0 1.5708 0"/>
      <geometry><capsule length="0.20" radius="0.026"/></geometry>
      <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.11 0 0" rpy="0 1.5708 0"/>
      <geometry><capsule length="0.20" radius="0.026"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.11 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="link3">
    <visual>
      <origin xyz="0.085 0 0" rpy="0 1.5708 0"/>
      <geometry><capsule length="0.14" radius="0.020"/></geometry>
      <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.085 0 0" rpy="0 1.5708 0"/>
      <geometry><capsule length="0.14" radius="0.020"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.085 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="tool">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder length="0.04" radius="0.012"/></geometry>
      <material name="suction"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder length="0.024" radius= "0.010"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.356" upper="2.356" effort="30" velocity="2.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.571" upper="1.571" effort="30" velocity="2.0"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.22 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" effort="30" velocity="2.0"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="tool"/>
    <origin xyz="0.17 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" effort="20" velocity="1.0"/>
  </joint>

  <link name="jaw_left">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.02 0.005 0.014"/></geometry>
      <material name="gripper_jaw"><color rgba="0.2 0.2 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.02 0.005 0.014"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <link name="jaw_right">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.02 0.005 0.014"/></geometry>
      <material name="gripper_jaw"><color rgba="0.2 0.2 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.02 0.005 0.014"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="joint_gripper_l" type="prismatic">
    <parent link="tool"/>
    <child link="jaw_left"/>
    <origin xyz="0.04 -0.0025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.0135" upper="0" effort="20" velocity="0.5"/>
  </joint>

  <joint name="joint_gripper_r" type="prismatic">
    <parent link="tool"/>
    <child link="jaw_right"/>
    <origin xyz="0.04 0.0025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.0135" effort="20" velocity="0.5"/>
  </joint>

</robot>
